            {
              "literal_MD": "1)",
              "contador_HTML": 1,
              "mesmo_numero": true,
              "contexto": "a data de encerramento na seção de averbações e alterações de qualquer natureza;\n"
            },
            {
              "literal_MD": "2)",
              "contador_HTML": 2,
              "mesmo_numero": true,
              "contexto": "a data em que deverão ter entrada, na Seção, os elementos necessários à apuração da freqüencia;\n"
            },
            {
              "literal_MD": "3)",
              "contador_HTML": 3,
